#pragma semicolon 1
#pragma newdecls required
#include <sourcemod>
#include <sdktools>

enum struct Building
{
    int effectRef;
    float lightRadius;
    int lightBrightness;
}
enum struct Resource
{
    int ref;
    int material;
    bool growing;
    float elapsed;
}
enum struct Material
{
    float hold;
    float grow;
    bool ease;
    int rgb[3];
}
Building gBuildings[1];Resource gNodes[1];Material gMaterials[1];
int gLightObservedRef[1],gInputs,gWrites,gPassed,gFailed;
int gRemovedLight,gRemovedResource;
bool gLightCanObserve[1],gPowered;
int Resolve(int ref){int entity=EntRefToEntIndex(ref);return entity>MaxClients && IsValidEntity(entity) ? entity:-1;}
bool BuildingPowered(int b){return b==0 && gPowered;}
bool CountInput(int entity,const char[] input){gInputs++;return AcceptEntityInput(entity,input);}
void CountColor(int entity,int r,int g,int b,int a){gWrites++;SetEntityRenderColor(entity,r,g,b,a);}
#define AcceptEntityInput CountInput
#define SetEntityRenderColor CountColor

// @PRODUCTION_FUNCTIONS@

void Check(bool pass,const char[] name)
{
    if(pass)gPassed++;else gFailed++;PrintToServer("[V083Entities] case=%s passed=%d",name,pass);
}

public Action Probe(int args)
{
    gPassed=0;gFailed=0;
    int light=CreateEntityByName("light_dynamic");
    if(light<0){Check(false,"allocate_light");return Plugin_Handled;}
    DispatchKeyValue(light,"_light","255 235 200 255");DispatchKeyValue(light,"brightness","2");DispatchKeyValue(light,"distance","150");
    float origin[3]={10000.0,10000.0,-8000.0};DispatchKeyValueVector(light,"origin",origin);DispatchSpawn(light);
    gBuildings[0].effectRef=EntIndexToEntRef(light);gBuildings[0].lightRadius=300.0;gBuildings[0].lightBrightness=3;gPowered=true;
    UpdateBuildingLight(0);
    Check(gLightCanObserve[0],"css_exposes_expected_light_fields");
    Check(GetEntPropFloat(light,Prop_Send,"m_Radius")==300.0 && GetEntProp(light,Prop_Send,"m_Exponent")==3 && GetEntProp(light,Prop_Data,"m_On",1)!=0,"actual_light_parameters_and_on");
    int before=gInputs;UpdateBuildingLight(0);Check(gInputs==before,"identical_light_update_has_zero_inputs");
    gPowered=false;UpdateBuildingLight(0);Check(GetEntProp(light,Prop_Data,"m_On",1)==0 && GetEntProp(light,Prop_Send,"m_Flags",1)==3,"actual_light_turnoff");
    before=gInputs;UpdateBuildingLight(0);Check(gInputs==before,"identical_off_has_zero_inputs");
    SetEntProp(light,Prop_Send,"m_Flags",0,1);UpdateBuildingLight(0);Check(GetEntProp(light,Prop_Send,"m_Flags",1)==3,"outside_flag_edit_repaired");
    gPowered=true;UpdateBuildingLight(0);Check(GetEntProp(light,Prop_Data,"m_On",1)!=0 && GetEntProp(light,Prop_Send,"m_Flags",1)==GetEntProp(light,Prop_Data,"m_ActualFlags",1),"actual_light_restore_original_flags");
    gRemovedLight=gBuildings[0].effectRef;RemoveEntity(light);
    light=CreateEntityByName("light_dynamic");DispatchKeyValueVector(light,"origin",origin);DispatchSpawn(light);gBuildings[0].effectRef=EntIndexToEntRef(light);UpdateBuildingLight(0);
    Check(gLightObservedRef[0]==gBuildings[0].effectRef && GetEntPropFloat(light,Prop_Send,"m_Radius")==300.0,"replacement_light_has_fresh_identity_and_parameters");RemoveEntity(light);

    char model[]="models/props/de_piranesi/pi_sundial.mdl";PrecacheModel(model,true);
    int body=CreateEntityByName("prop_dynamic_override");DispatchKeyValue(body,"model",model);DispatchKeyValue(body,"solid","6");DispatchKeyValueVector(body,"origin",origin);DispatchSpawn(body);
    SetEntityRenderMode(body,RENDER_TRANSCOLOR);gNodes[0].ref=EntIndexToEntRef(body);gNodes[0].material=0;gNodes[0].growing=false;
    gMaterials[0].hold=0.0;gMaterials[0].grow=10.0;gMaterials[0].rgb[0]=50;gMaterials[0].rgb[1]=100;gMaterials[0].rgb[2]=150;
    UpdateResourceVisual(0,true);int r,g,b,a;GetEntityRenderColor(body,r,g,b,a);
    Check(r==50 && g==100 && b==150 && a==255 && (GetEntProp(body,Prop_Send,"m_usSolidFlags")&4)==0 && GetEntProp(body,Prop_Send,"m_CollisionGroup")==2,"actual_resource_mature_visual_and_collision");
    before=gInputs;int writes=gWrites;UpdateResourceVisual(0);Check(before==gInputs && writes==gWrites,"identical_resource_has_zero_color_writes_and_inputs");
    gNodes[0].growing=true;gNodes[0].elapsed=0.0;UpdateResourceVisual(0);GetEntityRenderColor(body,r,g,b,a);
    Check(a==0 && (GetEntProp(body,Prop_Send,"m_usSolidFlags")&4)!=0,"depletion_disables_actual_collision");
    gNodes[0].elapsed=5.0;UpdateResourceVisual(0);GetEntityRenderColor(body,r,g,b,a);Check(a==128,"actual_half_growth_alpha");
    before=gInputs;UpdateResourceVisual(0);Check(before==gInputs,"growth_does_not_resend_disable_collision");
    SetEntityCollisionGroup(body,5);SetEntityRenderColor(body,255,255,255,255);SetEntProp(body,Prop_Send,"m_usSolidFlags",GetEntProp(body,Prop_Send,"m_usSolidFlags")&~4);
    UpdateResourceVisual(0);GetEntityRenderColor(body,r,g,b,a);
    Check(GetEntProp(body,Prop_Send,"m_CollisionGroup")==2 && (GetEntProp(body,Prop_Send,"m_usSolidFlags")&4)!=0 && r==50 && a==128,"outside_resource_edits_repaired_with_native_input");
    SetEntityModel(body,model);before=gInputs;UpdateResourceVisual(0,true);Check(gInputs==before+1,"model_reset_forces_partition_input");
    gNodes[0].growing=false;UpdateResourceVisual(0);Check((GetEntProp(body,Prop_Send,"m_usSolidFlags")&4)==0,"maturity_restores_actual_collision");
    gRemovedResource=gNodes[0].ref;RemoveEntity(body);CreateTimer(0.2,AfterRemoval,0,TIMER_FLAG_NO_MAPCHANGE);
    return Plugin_Handled;
}

public Action AfterRemoval(Handle timer,any value)
{
    #pragma unused value
    int before=gInputs;gBuildings[0].effectRef=gRemovedLight;UpdateBuildingLight(0);
    PrintToServer("[V083Entities] removed_light_ref=%d resolved=%d before=%d after=%d",gRemovedLight,Resolve(gRemovedLight),before,gInputs);
    Check(Resolve(gRemovedLight)<0 && before==gInputs,"missing_light_is_safe_after_deferred_removal");
    before=gInputs;UpdateResourceVisual(0);Check(Resolve(gRemovedResource)<0 && before==gInputs,"missing_resource_safe_after_deferred_removal");
    PrintToServer("[V083Entities] removed_resource_ref=%d resolved=%d before=%d after=%d",gRemovedResource,Resolve(gRemovedResource),before,gInputs);
    return Plugin_Stop;
}
public Action Status(int args)
{
    PrintToServer("[V083Entities] checks=%d failures=%d; real engine native inputs/entities, diagnostic hidden position, not multiplayer or visible-map-light acceptance",gPassed+gFailed,gFailed);return Plugin_Handled;
}
public void OnPluginStart(){RegServerCmd("sm_v083_entity_checks",Probe);RegServerCmd("sm_v083_entity_status",Status);}
